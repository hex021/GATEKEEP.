# Spotify OAuth 2.0 PKCE Client ID (Obtained from developer.spotify.com/dashboard)
# Note: Users can also enter this directly in the VibeSync UI without rebuilding!
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Spotify OAuth Redirect URI (Spotify requires explicit 127.0.0.1 loopback; localhost is disallowed)
# For local development: http://127.0.0.1:3000/callback
NEXT_PUBLIC_REDIRECT_URI=http://127.0.0.1:3000/callback
